# =============================================================================
# Flock — local environment template
# =============================================================================
# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Sign-up links below each key. "self-serve" = key in minutes.
# "approval" = application review, typically 1-4 weeks.


# -----------------------------------------------------------------------------
# CORE — needed for anything Claude-facing to run
# -----------------------------------------------------------------------------

# Anthropic Messages API + mcp_servers (beta: mcp-client-2025-11-20)
#   self-serve: https://console.anthropic.com/
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# FLIGHTS — self-serve, get these today
# -----------------------------------------------------------------------------

# Duffel — modern NDC flights (search + book). Sandbox is free.
#   self-serve: https://dashboard.duffel.com/
DUFFEL_API_KEY=

# Amadeus Self-Service — flights, hotels, transfers, points-of-interest.
# Test tier is free. Production needs a paid upgrade.
#   self-serve: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Kiwi Tequila — optional alternative to their public MCP. Not required
# for M1 since mcp.kiwi.com works unauthenticated.
#   self-serve: https://tequila.kiwi.com/portal/login
KIWI_TEQUILA_API_KEY=


# -----------------------------------------------------------------------------
# HOTELS — approval required (~1-2 weeks)
# -----------------------------------------------------------------------------

# Booking.com Affiliate Partner Network — full hotel inventory, commission.
#   apply: https://partner.booking.com/en-gb/affiliate-programme
BOOKING_AFFILIATE_ID=
BOOKING_AFFILIATE_API_TOKEN=


# -----------------------------------------------------------------------------
# ACTIVITIES — approval required (~1-3 weeks)
# -----------------------------------------------------------------------------

# Viator Partner API — tours, day trips, experiences.
#   apply: https://www.viatorpartner.com/
VIATOR_API_KEY=

# GetYourGuide Partner API — alternative activities inventory.
#   apply: https://partner.getyourguide.com/
GETYOURGUIDE_API_KEY=


# -----------------------------------------------------------------------------
# REVIEWS / ATTRACTIONS — approval required (~1-4 weeks)
# -----------------------------------------------------------------------------

# TripAdvisor Content API — reviews, ratings, attraction metadata.
# Free tier is 5K calls/day.
#   apply: https://developer.tripadvisor.com/
TRIPADVISOR_API_KEY=


# -----------------------------------------------------------------------------
# GOOGLE OAUTH — Gmail inbox parsing + Calendar itinerary
# -----------------------------------------------------------------------------
# Setup:
#   1. https://console.cloud.google.com/ → new project "Flock (dev)"
#   2. APIs & Services → Enable: Gmail API, Google Calendar API
#   3. OAuth consent screen: External, add your own email as a test user
#   4. Credentials → Create OAuth client ID → "Web application"
#   5. Authorized redirect URI: http://localhost:3000/api/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback


# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------

# Public base URL (swap for prod deploy URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# M3 — leave blank until we add real auth + DB
# -----------------------------------------------------------------------------

# DATABASE_URL=
# TOKEN_VAULT_ENCRYPTION_KEY=
# CLERK_SECRET_KEY=
